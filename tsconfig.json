{
    "compileOnSave": true,
    "compilerOptions": {
        "module": "Node16",
        "target": "ESNext",
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "experimentalDecorators": true,
        "moduleResolution": "Node16",
        "strict": false,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "stripInternal": true,
        "jsx": "preserve",
        "types": ["node"],
        "rootDir": "src",
        "outDir": "dist",
        "newLine": "lf"
    },
    "include": [
        "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "test"
    ]
}
